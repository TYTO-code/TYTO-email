{
  "name": "tyto-email",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de e-mails do TYTO.club (Cloud Functions + fila no Firestore + Resend)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions:tyto-email"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
