# Copie para .env (lido pelo Firebase CLI no deploy).

# Região das functions — use a MESMA localização do banco Firestore
# (ex.: southamerica-east1; para o multirregional nam5, us-central1).
FUNCTIONS_REGION=us-central1

# Remetente (o domínio precisa estar verificado no Resend).
MAIL_FROM=TYTO.club <nao-responda@tyto.club>

# Link usado nos botões dos e-mails.
APP_URL=https://tyto.club

# Limite de e-mails de notificação por membro por hora (o excedente fica só no app).
NOTIFICATION_EMAILS_PER_HOUR=10

# A chave do Resend NÃO vai aqui — é um secret:
#   firebase functions:secrets:set RESEND_API_KEY
